#!/bin/bash
# prefer the root exported by the AppImage runtime; fall back to deriving it
APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"

LOADERS_DIR="${APPDIR}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders"
TMP_LOADERS_CACHE="$(mktemp)"

# build the cache with the host's query tool so host formats are present;
# our bundled loaders are passed on top (dir argument for <=2.42 tools,
# module list for newer ones), falling back to the bundled cache
GEN_OK=0
MODS=()
for f in "$LOADERS_DIR"/*.so; do
    [ -e "$f" ] && MODS+=("${f%.so}")
done
for QT in gdk-pixbuf-query-loaders \
          /usr/lib/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders \
          /usr/lib/*/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders; do
    QT_CMD="$(command -v "$QT" 2>/dev/null)" || continue
    if "$QT_CMD" "$LOADERS_DIR" > "$TMP_LOADERS_CACHE" 2>/dev/null \
       && grep -q '^"' "$TMP_LOADERS_CACHE"; then
        GEN_OK=1
        break
    fi
    if [ ${#MODS[@]} -gt 0 ] \
       && "$QT_CMD" "${MODS[@]}" > "$TMP_LOADERS_CACHE" 2>/dev/null \
       && grep -q '^"' "$TMP_LOADERS_CACHE"; then
        GEN_OK=1
        break
    fi
done

if [ "$GEN_OK" -ne 1 ]; then
    cp "${LOADERS_DIR}/loaders.cache" "$TMP_LOADERS_CACHE"
    sed -i -e "s#/usr#${APPDIR}/usr#g" "$TMP_LOADERS_CACHE"
fi

# libs
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${LD_LIBRARY_PATH}"

# icons etc.
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS}"

# point to the local pixbuf cache
export GDK_PIXBUF_MODULE_FILE="${TMP_LOADERS_CACHE}"

# PLplot
export PLPLOT_LIB="${APPDIR}/usr/share/plplot5.15.0"
export PLPLOT_DRV_DIR="${APPDIR}/usr/lib/plplot5.15.0/drivers"

exec "$APPDIR/usr/bin/UncertRadio" "$@"
